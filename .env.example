# This pack renders 100% locally — there are no API keys or secrets to set.
# Everything below is optional tuning. Copy to `.env` only if you want it:
#   cp .env.example .env

# Frames rendered in parallel. Higher = faster on machines with many cores;
# lower it (e.g. 2) on memory-constrained CI runners. Read by remotion.config.ts.
# Default when unset: 4
REMOTION_CONCURRENCY=4

# Any variable prefixed with REMOTION_ is exposed to your compositions through
# process.env at render time (useful for build-stamped watermarks or flags).
# Uncomment to try it, then read process.env.REMOTION_BUILD_LABEL in a template.
# REMOTION_BUILD_LABEL=local-dev
